# Smart Kitchen Platform Environment Variables Example
PORT=3000
DEVICE_ID=smart-kitchen-001
DEVICE_API_KEY=ganti_dengan_kunci_perangkat_minimal_8_karakter
DASHBOARD_USER=admin_kitchen
DASHBOARD_PASSWORD=ganti_dengan_password_minimal_8_karakter

# Mode Database:
# Biarkan DEMO_LOCAL=1 jika ingin latihan lokal tanpa PostgreSQL
DEMO_LOCAL=1

# Konfigurasi PostgreSQL Cloud (Render / Supabase):
# Kosongkan atau hapus DEMO_LOCAL jika menggunakan PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
# DATABASE_SSL_CA=/etc/secrets/prod-ca-2021.crt

# Notifikasi Telegram (Opsional):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

